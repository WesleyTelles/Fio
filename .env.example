# ============ FRONTEND (públicas — vão para o bundle) ============
# Supabase: Project Settings → API. A chave anônima só é segura porque o RLS protege todas as tabelas.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica
# (opcional) identificador do build exibido no Perfil
# VITE_BUILD_ID=

# ============ SERVIDOR (Edge Function `interpret` — NUNCA no frontend) ============
# Configure com: supabase secrets set NOME=valor   (não crie arquivo com valores reais no repositório)
# Provedor de IA (escolhido pela chave que existir; Gemini tem preferência se houver as duas):
# GEMINI_API_KEY=               # Google AI Studio (só no servidor)
# GEMINI_MODEL=gemini-3.1-flash-lite   # confirme o id vigente na documentação
# ANTHROPIC_API_KEY=            # alternativa: Claude (só no servidor)
# ANTHROPIC_MODEL=claude-haiku-4-5
# AI_MODE=demo|off|gemini|anthropic   (opcional; sem chave nenhuma => demo; pedir IA sem chave => desligado)
# AI_PROVIDER=gemini|anthropic        (opcional; força o provedor)
# ALLOWED_ORIGIN=https://seu-dominio.com
# AI_TIMEOUT_MS=8000
# SUPABASE_URL e SUPABASE_ANON_KEY são injetadas automaticamente nas Edge Functions. A service_role NÃO é usada.

# ============ TESTES LOCAIS (tools/gateway e testes de banco) ============
# FIO_PG_PORT=54329  GATEWAY_PORT=54321  JWT_SECRET=somente-para-testes
